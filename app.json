{
  "name": "Enterprise ERP System",
  "description": "Comprehensive Enterprise Resource Planning system built with Laravel",
  "repository": "https://github.com/AmrElsayed-1994/enterprise-erp-system",
  "logo": "https://laravel.com/img/logomark.min.svg",
  "keywords": ["laravel", "erp", "php", "enterprise", "management"],
  "stack": "heroku-22",
  "buildpacks": [
    {
      "url": "heroku/php"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "addons": [
    {
      "plan": "heroku-postgresql:essential-0"
    }
  ],
  "env": {
    "APP_NAME": {
      "description": "Application name",
      "value": "Enterprise ERP System"
    },
    "APP_ENV": {
      "description": "Application environment",
      "value": "production"
    },
    "APP_DEBUG": {
      "description": "Enable debug mode for troubleshooting",
      "value": "true"
    },
    "APP_KEY": {
      "description": "Application encryption key",
      "generator": "secret"
    },
    "APP_URL": {
      "description": "Application URL",
      "required": false
    },
    "DB_CONNECTION": {
      "description": "Database connection type",
      "value": "pgsql"
    },
    "LOG_CHANNEL": {
      "description": "Log channel",
      "value": "stack"
    },
    "LOG_LEVEL": {
      "description": "Log level for debugging",
      "value": "debug"
    },
    "SESSION_DRIVER": {
      "description": "Session driver",
      "value": "database"
    },
    "CACHE_DRIVER": {
      "description": "Cache driver",
      "value": "database"
    },
    "QUEUE_CONNECTION": {
      "description": "Queue connection",
      "value": "database"
    },
    "SESSION_SECURE_COOKIE": {
      "description": "Secure cookies for HTTPS",
      "value": "true"
    },
    "SESSION_SAME_SITE": {
      "description": "SameSite cookie attribute",
      "value": "lax"
    }
  },
  "scripts": {
    "postdeploy": "php artisan config:cache && php artisan route:cache && php artisan migrate --force && php artisan db:seed --force"
  }
}
